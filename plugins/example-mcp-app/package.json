{
  "name": "@repo-kit/example-mcp-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An inspectable MCP App: real protocol traffic, resources and lifecycle",
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "dist",
    "plugin.json",
    "mcp.json",
    "README.md",
    "design.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node dist/server.mjs",
    "preview": "node dist/preview.mjs",
    "probe:codex": "node scripts/probe-codex.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run lint && npm run typecheck && npm run build && npm test",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/build-test-host.ts && playwright test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "zod": "4.6.7"
  }
}
