{
  "name": "@repo-kit/workbench",
  "version": "0.3.0",
  "description": "Repository architecture and recorded-session workbench for Codex",
  "type": "module",
  "bin": {
    "repo-workbench": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "plugin.json",
    "mcp.json",
    "skills",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test packages/trace/*.test.ts packages/usage/*.test.ts tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "prepack": "npm run build",
    "test:package": "node --test tests/package.test.ts"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.14",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  }
}
